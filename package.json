{
  "name": "srinivasa-medical-agencies-hybrid",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\" \"npm:dev:reports\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "dev:reports": "python reports/service.py",
    "build": "vite build",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.72.0",
    "mongoose": "^8.19.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^6.4.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
